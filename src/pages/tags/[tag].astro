---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostCard from "@/components/PostCard.astro";
import { getPublishedPosts } from "@/utils/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Bài viết về chủ đề ${tag}.`}>
  <Header />
  <main class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <a
      href="/tags"
      class="mb-6 inline-flex items-center gap-2 text-sm font-medium text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)]"
    >
      ← Tất cả chủ đề
    </a>
    <h1 class="font-display text-3xl font-bold text-[var(--color-fg)]">#{tag}</h1>
    <p class="mt-2 text-[var(--color-muted)]">{posts.length} bài viết</p>

    <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </main>
  <Footer />
</BaseLayout>
