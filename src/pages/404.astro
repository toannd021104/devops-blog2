---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { withBase } from "@/utils/url";
---

<BaseLayout title="Không tìm thấy trang">
  <Header />
  <main class="mx-auto flex min-h-[60vh] max-w-5xl flex-col items-center justify-center px-4 text-center">
    <p class="font-mono text-6xl font-bold text-[var(--color-accent)]">404</p>
    <h1 class="mt-4 font-display text-2xl font-bold text-[var(--color-fg)]">
      Rất tiếc, không tìm thấy trang này
    </h1>
    <p class="mt-3 text-[var(--color-muted)]">
      Có thể đường dẫn đã đổi hoặc bài viết không tồn tại.
    </p>
    <a
      href={withBase("/")}
      class="mt-6 rounded-lg bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-[var(--color-accent-fg)] transition-opacity hover:opacity-90"
    >
      Về trang chủ
    </a>
  </main>
  <Footer />
</BaseLayout>
